---
import { fleetViews } from "../lib/fleet";

// Previous and next at the foot of a Fleet page, in the Fleet's own order, as
// a Starlight page ends.

interface Props {
  /** "overview", or the measurement's id. */
  current: string;
}
const { current } = Astro.props;
const views = await fleetViews();
const i = views.findIndex((v) => v.id === current);
const prev = i > 0 ? views[i - 1] : undefined;
const next = i >= 0 && i < views.length - 1 ? views[i + 1] : undefined;
---

<nav class="pager" aria-label="Previous and next in the Fleet">
  {
    prev ? (
      <a class="prev" href={prev.href} rel="prev">
        <span class="k">Previous</span>
        <span class="t">{prev.label}</span>
      </a>
    ) : (
      <span />
    )
  }
  {
    next && (
      <a class="next" href={next.href} rel="next">
        <span class="k">Next</span>
        <span class="t">{next.label}</span>
      </a>
    )
  }
</nav>

<style>
  .pager { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 56px; }
  a {
    display: grid; gap: 2px; padding: 14px 18px; border: 1px solid var(--ap-line); border-radius: var(--ap-radius);
    text-decoration: none; color: var(--ap-fg); transition: border-color 0.15s;
  }
  a:hover { border-color: var(--ap-fg-3); color: var(--ap-fg); }
  .next { text-align: right; grid-column: 2; }
  .k { font: 500 0.75rem/1.6 var(--ap-font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ap-fg-3); }
  .t { font: 700 1.15rem/1.3 var(--ap-font-display); letter-spacing: var(--ap-tracking-display); }
  .prev .t::before { content: "← "; color: var(--ap-accent); }
  .next .t::after { content: " →"; color: var(--ap-accent); }
  @media (prefers-reduced-motion: reduce) { a { transition: none; } }
  @media (max-width: 30rem) {
    .pager { grid-template-columns: minmax(0, 1fr); }
    .next { grid-column: 1; }
  }
</style>

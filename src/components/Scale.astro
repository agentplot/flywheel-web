---
import { getEntry } from "astro:content";

// One agent to a thousand as a single scale: a thousand dots set along a
// logarithmic axis, so the nth dot sits at n and the field thickens toward
// the right. The fleet lights its share of the dots from the latest collected
// peak of agents running; a sample is never read here, so until the
// collector's first point lands nothing is lit.

const record = await getEntry("measurements", "fleet-utilization");
const series = record?.data.series ?? [];
const collected = (name: string, peak: boolean) =>
  (series.find((s) => (peak ? s.peakOf === name : s.name === name))?.points ?? []).filter((p) => !p.sample);
const peaks = collected("agents running", true);
const latest = peaks.at(-1);
const busy = collected("agents busy", false).at(-1);
const running = collected("agents running", false).at(-1);
const lit = latest?.value ?? 0;

// A seeded scatter, the same on every build, loose like a field of lights.
const rand = (i: number) => {
  const v = Math.sin(i * 12.9898 + 78.233) * 43758.5453;
  return v - Math.floor(v);
};
const top = 18, pad = 14;
// The field drawn at one size: wide for a screen, taller and narrower for a
// phone, so neither squeezes the dots or the labels. Each dot is a
// zero-length round-capped stroke, one path per size and state.
const field = (W: number, h: number, big: number) => {
  const x = (n: number) => pad + (Math.log10(n) / 3) * (W - 2 * pad);
  const groups = new Map<string, string>();
  for (let i = 1; i <= 1000; i++) {
    const r = Math.max(1.1, big - (big - 1.1) * (Math.log10(i) / 3) * 1.15);
    const key = `${i <= lit ? "on" : "off"} ${(2 * r).toFixed(1)}`;
    groups.set(key, (groups.get(key) ?? "") + `M${x(i).toFixed(1)},${(top + rand(i) * h).toFixed(1)}h0`);
  }
  const paths = [...groups].map(([k, d]) => ({ cls: k.split(" ")[0], width: k.split(" ")[1], d }));
  return { W, h, x, paths, H: top + h + 46 };
};
const views = [
  { cls: "wide", ...field(1100, 132, 6) },
  { cls: "narrow", ...field(560, 190, 4.6) },
];
const marks = [1, 5, 20, 50, 100, 500, 1000];
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<section class="scale" aria-labelledby="scale-title">
  <div class="head">
    <p class="eyebrow" id="scale-title">One agent to a thousand</p>
    <p class="axis-note">Each dot is one agent, on a log scale</p>
  </div>
  {
    views.map((v) => (
      <svg
        class={v.cls}
        viewBox={`0 0 ${v.W} ${v.H}`}
        role="img"
        aria-label={lit ? `A thousand dots, one per agent; the first ${lit} are lit, the fleet's latest peak.` : "A thousand dots, one per agent, sparse at one and dense at a thousand; none is lit until the fleet's first collected reading."}
      >
        <defs>
          <linearGradient id={`sweep-${v.cls}`} x1="0" x2="1" y1="0" y2="0">
            <stop offset="0" stop-color="var(--brass)" stop-opacity="0" />
            <stop offset=".5" stop-color="var(--brass)" stop-opacity=".22" />
            <stop offset="1" stop-color="var(--brass)" stop-opacity="0" />
          </linearGradient>
          <clipPath id={`field-${v.cls}`}>
            <rect x="0" y={top - 10} width={v.W} height={v.h + 20} />
          </clipPath>
        </defs>
        {v.paths.map((p) => <path class={p.cls} d={p.d} stroke-width={p.width} />)}
        <g clip-path={`url(#field-${v.cls})`}>
          <rect class="sweep" x="-160" y={top - 8} width="160" height={v.h + 16} fill={`url(#sweep-${v.cls})`} style={`--run:${v.W + 160}px`} />
        </g>
        {lit > 0 && <line class="here" x1={v.x(lit)} x2={v.x(lit)} y1={top - 10} y2={top + v.h + 10} />}
        <g class="ticks">
          {marks.map((m) => (
            <>
              <line x1={v.x(m)} x2={v.x(m)} y1={top + v.h + 12} y2={top + v.h + 20} />
              <text x={v.x(m)} y={top + v.h + 38} text-anchor={m === 1 ? "start" : m === 1000 ? "end" : "middle"}>
                {v.cls === "narrow" && (m === 5 || m === 50 || m === 500) ? "" : m.toLocaleString("en")}
              </text>
            </>
          ))}
        </g>
      </svg>
    ))
  }

  <div class="stand">
    <div>
      <p class="label">Where the fleet stands</p>
      {
        latest ? (
          <p class="reading">
            <b>{latest.value}</b> agents at the peak on {iso(latest.date)}
            {running && busy && running.value > 0 && <>, {Math.round((100 * busy.value) / running.value)}% of them busy</>}
          </p>
        ) : (
          <p class="reading pending">Marked here from the fleet's first collected reading.</p>
        )
      }
    </div>
    <a class="go" href="/fleet/fleet-utilization/">Fleet utilization</a>
  </div>
</section>

<style>
  .scale { margin: 64px 0 0; padding: 28px 24px 22px; border: 1px solid var(--line); border-radius: 14px; background: rgba(9, 28, 31, 0.5); }
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; margin-bottom: 10px; }
  .axis-note { margin: 0; font: 11px/1.6 var(--mono); color: var(--ink-3); }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .narrow { display: none; }
  @media (max-width: 40rem) {
    .wide { display: none; }
    .narrow { display: block; }
  }
  .off { fill: none; stroke: var(--mint); stroke-opacity: 0.38; stroke-linecap: round; }
  .on { fill: none; stroke: var(--brass); stroke-linecap: round; }
  .here { stroke: var(--brass); stroke-width: 1.5; stroke-dasharray: 2 4; }
  .ticks line { stroke: var(--line); }
  .ticks text { fill: var(--ink-3); font: 12px var(--mono); }
  .narrow .ticks text { font-size: 13px; }

  /* Momentum: a slow light runs toward the thousand. */
  .sweep { animation: sweep 9s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
  @keyframes sweep { from { transform: translateX(0); } to { transform: translateX(var(--run)); } }
  @media (prefers-reduced-motion: reduce) { .sweep { display: none; } }

  .stand { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 12px 24px; margin-top: 18px; border-top: 1px solid var(--line-soft); padding-top: 16px; }
  .label { margin: 0 0 4px; font: 10.5px/1.5 var(--mono); letter-spacing: 0.2em; text-transform: uppercase; color: var(--mint); }
  .reading { margin: 0; font: 500 1.1rem/1.4 var(--display); color: var(--ink); }
  .reading b { font-size: 1.9rem; color: var(--brass); letter-spacing: -0.02em; }
  .reading.pending { color: var(--ink-2); font: 1rem/1.5 var(--serif); }
  .go { font: 11px/1.6 var(--mono); letter-spacing: 0.16em; text-transform: uppercase; white-space: nowrap; }
  .go::after { content: " →"; }
</style>

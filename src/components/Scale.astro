---
import { url } from "../lib/url";
import { getEntry } from "astro:content";

// One agent to a thousand as one instrument: a dial open at the bottom, the
// form Flywheel Next's runway takes too, sweeping on a log scale from one at
// the bottom left over the top to a thousand at the bottom right. Each
// tenfold step is shaded; the track fills in brass to the fleet's latest
// collected peak of agents running, solid as far as the busy peak and
// outlined beyond it. The reading sits inside: a label, the number, a line
// naming the state. A sample is never read here, so until the collector's
// first point lands nothing is filled.

const record = await getEntry("measurements", "fleet-utilization");
const series = record?.data.series ?? [];
const collected = (name: string) => (series.find((s) => s.peakOf === name)?.points ?? []).filter((p) => !p.sample);
const iso = (d: Date) => d.toISOString().slice(0, 10);
const latest = collected("agents running").at(-1);
// The busy peak of the same day, when there is one.
const busyPeak = latest && collected("agents busy").find((p) => iso(p.date) === iso(latest.date));
const lit = Math.min(1000, latest?.value ?? 0);
const busy = Math.min(lit, busyPeak?.value ?? 0);

// The dial: 270 degrees of a ring, open at the bottom.
const V = 320, H = 292, c = { x: 160, y: 160 }, r0 = 102, r1 = 122, rm = (r0 + r1) / 2;
const a0 = Math.PI * 0.75, sweep = Math.PI * 1.5;
const r2 = (v: number) => +v.toFixed(2);
const A = (n: number) => a0 + (Math.min(3, Math.log10(Math.max(1, n))) / 3) * sweep;
const P = (r: number, a: number) => [r2(c.x + r * Math.cos(a)), r2(c.y + r * Math.sin(a))];
const sector = (ra: number, rb: number, b0: number, b1: number) => {
  if (b1 - b0 <= 1e-4) return "";
  const L = b1 - b0 > Math.PI ? 1 : 0;
  const [x0, y0] = P(rb, b0), [x1, y1] = P(rb, b1), [x2, y2] = P(ra, b1), [x3, y3] = P(ra, b0);
  return `M${x0},${y0}A${rb},${rb} 0 ${L} 1 ${x1},${y1}L${x2},${y2}A${ra},${ra} 0 ${L} 0 ${x3},${y3}Z`;
};
const arc = (r: number, b0: number, b1: number, reverse = false) => {
  const L = b1 - b0 > Math.PI ? 1 : 0;
  const [x0, y0] = P(r, b0), [x1, y1] = P(r, b1);
  return reverse ? `M${x1},${y1}A${r},${r} 0 ${L} 0 ${x0},${y0}` : `M${x0},${y0}A${r},${r} 0 ${L} 1 ${x1},${y1}`;
};

// Each decade's caption runs along the inside of the track, kept upright.
const decades = [
  [1, 10],
  [10, 100],
  [100, 1000],
].map(([a, b], k) => {
  const mid = (A(a) + A(b)) / 2, low = Math.sin(mid) > 0.25;
  return { k, zone: sector(r0, r1, A(a), A(b)), path: arc(low ? r0 - 4 : r0 - 11, A(a), A(b), low), cap: `${a.toLocaleString("en")} to ${b.toLocaleString("en")}` };
});
const minor = [1, 10, 100].flatMap((d) => [2, 3, 4, 5, 6, 7, 8, 9].map((m) => d * m)).map((n) => [...P(r1, A(n)), ...P(r1 - 5, A(n))]);
const steps = [10, 100].map((n) => [...P(r0 - 4, A(n)), ...P(r1 + 4, A(n))]);
const labels = [1, 5, 10, 20, 50, 100, 500, 1000].map((m) => {
  const a = A(m), [x, y] = P(r1 + 22, a), cos = Math.cos(a);
  const anchor = cos > 0.35 ? "start" : cos < -0.35 ? "end" : "middle";
  return { text: m.toLocaleString("en"), x: r2(x - (anchor === "start" ? 6 : anchor === "end" ? -6 : 0)), y: r2(y + 4), anchor };
});
const pointer = (() => {
  if (!lit) return "";
  const a = A(lit), [tx, ty] = P(r1 + 3, a), [bx, by] = P(r1 + 13, a);
  const nx = -Math.sin(a) * 6, ny = Math.cos(a) * 6;
  return `M${tx},${ty}L${r2(bx + nx)},${r2(by + ny)}L${r2(bx - nx)},${r2(by - ny)}Z`;
})();
const label = lit
  ? `A dial from one agent to a thousand on a log scale, filled to ${lit} agents at the fleet's latest peak, ${busy} of them busy at once.`
  : "A dial from one agent to a thousand on a log scale, each tenfold step shaded; nothing is filled until the fleet's first collected reading.";
---

<section class="scale" aria-labelledby="scale-title">
  <div class="head">
    <p class="eyebrow" id="scale-title">One agent to a thousand</p>
    <p class="axis-note">Agents at the fleet's peak, on a log scale</p>
  </div>

  <div class="instrument">
    <div class="dial" style={`--h:${((2 * c.y) / H) * 100}%`}>
      <svg viewBox={`0 0 ${V} ${H}`} role="img" aria-label={label}>
        <defs>
          {decades.map((d) => <path id={`scale-cap-${d.k}`} d={d.path} fill="none" />)}
        </defs>
        {
          decades.map((d) => (
            <>
              <path class={`decade d${d.k}`} d={d.zone} />
              <text class="cap">
                <textPath href={`#scale-cap-${d.k}`} startOffset="50%" text-anchor="middle">
                  {d.cap}
                </textPath>
              </text>
            </>
          ))
        }
        <path class="track" d={sector(r0, r1, A(1), A(1000))} />
        <path class="sweep" d={arc(rm, A(1), A(1000))} pathLength="1000" />
        {minor.map(([x1, y1, x2, y2]) => <line class="minor" x1={x1} y1={y1} x2={x2} y2={y2} />)}
        {steps.map(([x1, y1, x2, y2]) => <line class="step" x1={x1} y1={y1} x2={x2} y2={y2} />)}
        {lit > busy && <path class="idle" d={sector(r0 + 5.5, r1 - 5.5, A(busy || 1), A(lit))} />}
        {busy > 0 && <path class="busy" d={sector(r0 + 5, r1 - 5, A(1), A(busy))} />}
        {pointer && <path class="pointer" d={pointer} />}
        {
          labels.map((l) => (
            <text class="lab" x={l.x} y={l.y} text-anchor={l.anchor}>
              {l.text}
            </text>
          ))
        }
      </svg>
      <div class="read">
        <span class="k">Agents at the peak</span>
        <span class:list={["num", { none: !lit }]}>{lit || "—"}</span>
        <span class="band">{lit ? `at most ${busy} busy at once` : "waits for the first collected reading"}</span>
      </div>
    </div>

    <div class="side">
      {latest && <p class="when">Read on {iso(latest.date)}</p>}
      {
        lit > 0 && (
          <p class="key">
            <i class="k-busy" /> busy <i class="k-idle" /> running, not busy
          </p>
        )
      }
      <div class="stand">
        <p class="label">You can see it</p>
        <p class="call">The fleet measured, and everything on the record.</p>
        <a class="go" href={url("/fleet/fleet-utilization/")}>Fleet utilization</a>
      </div>
    </div>
  </div>
</section>

<style>
  .scale { margin: 64px 0 0; padding: 28px 24px 24px; border: 1px solid var(--ap-line); border-radius: 14px; background: var(--ap-bg-2); }
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; margin-bottom: 8px; }
  .axis-note { margin: 0; font: 11px/1.6 var(--ap-font-mono); color: var(--ap-fg-3); }

  .instrument { display: grid; grid-template-columns: minmax(0, 23rem) minmax(0, 1fr); gap: 16px 48px; align-items: center; }

  /* The dial, with the reading inside it as the priming dial reads: a label,
     the number, a line naming the state. */
  .dial { position: relative; width: 100%; max-width: 23rem; margin: 0 auto; container-type: inline-size; }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .read { position: absolute; left: 0; right: 0; top: 0; height: var(--h); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 0.6cqw; pointer-events: none; }
  .k { font: 2.9cqw/1.5 var(--ap-font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ap-fg-3); }
  .num { font: 700 15cqw/1 var(--ap-font-display); letter-spacing: -0.03em; color: var(--ap-accent); font-variant-numeric: tabular-nums; }
  .num.none { color: var(--ap-fg-3); }
  .band { font: 600 4.1cqw/1.3 var(--ap-font-display); color: var(--ap-fg-2); max-width: 50cqw; }

  .decade { fill: var(--mint); }
  .d0 { fill-opacity: 0.05; }
  .d1 { fill-opacity: 0.09; }
  .d2 { fill-opacity: 0.13; }
  .track { fill: none; stroke: var(--ap-line); }
  .cap { fill: var(--ap-fg-3); font: 10px var(--ap-font-mono); letter-spacing: 0.04em; }
  .minor { stroke: var(--ap-fg-3); stroke-opacity: 0.55; }
  .step { stroke: var(--ap-fg); stroke-opacity: 0.45; }
  .busy { fill: var(--ap-accent); }
  .idle { fill: none; stroke: var(--ap-accent); stroke-width: 1.3; }
  .pointer { fill: var(--ap-accent); }
  .lab { fill: var(--ap-fg-3); font: 11.5px var(--ap-font-mono); }

  .side { display: grid; gap: 14px; align-content: center; }
  .when { margin: 0; font: 11px/1.6 var(--ap-font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ap-fg-3); }
  .key { margin: 0; font: 11px/1.6 var(--ap-font-mono); color: var(--ap-fg-3); display: flex; gap: 6px 10px; align-items: center; flex-wrap: wrap; }
  .key i { display: inline-block; width: 14px; height: 9px; border-radius: 2px; }
  .k-busy { background: var(--ap-accent); }
  .k-idle { border: 1.3px solid var(--ap-accent); }

  /* Momentum: a slow light runs along the track toward the thousand. */
  .sweep { fill: none; stroke: var(--ap-accent); stroke-opacity: 0.22; stroke-width: 20; stroke-dasharray: 70 1000; animation: sweep 9s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
  @keyframes sweep { from { stroke-dashoffset: 70; } to { stroke-dashoffset: -1000; } }
  @media (prefers-reduced-motion: reduce) { .sweep { display: none; } }

  .stand { border-top: 1px solid var(--ap-line-soft); padding-top: 14px; }
  .label { margin: 0 0 4px; font: 10.5px/1.5 var(--ap-font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ap-fg-3); }
  .call { margin: 0 0 10px; font: 500 1.15rem/1.4 var(--ap-font-display); color: var(--ap-fg); }
  .go { font: 11px/1.6 var(--ap-font-mono); letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; }
  .go::after { content: " →"; }

  @media (max-width: 40rem) {
    .scale { padding: 22px 16px 20px; }
    .instrument { grid-template-columns: minmax(0, 1fr); }
    .dial { max-width: 20rem; }
  }
</style>

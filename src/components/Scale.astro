---
import { getEntry } from "astro:content";

// One agent to a thousand as one instrument: a ruler on a log scale, each
// tenfold step shaded, filled in brass to the fleet's latest collected peak
// of agents running, solid as far as the busy peak and outlined beyond it.
// The reading beside it is read the way Flywheel Next's priming dial reads,
// a number with a line naming the state. A sample is never read here, so
// until the collector's first point lands nothing is filled.

const record = await getEntry("measurements", "fleet-utilization");
const series = record?.data.series ?? [];
const collected = (name: string) => (series.find((s) => s.peakOf === name)?.points ?? []).filter((p) => !p.sample);
const iso = (d: Date) => d.toISOString().slice(0, 10);
const latest = collected("agents running").at(-1);
// The busy peak of the same day, when there is one.
const busyPeak = latest && collected("agents busy").find((p) => iso(p.date) === iso(latest.date));
const lit = Math.min(1000, latest?.value ?? 0);
const busy = Math.min(lit, busyPeak?.value ?? 0);

// The ruler at one size: wide beside the reading, narrow under it on a phone.
const ruler = (W: number, pad: number, labels: number[]) => {
  const x = (n: number) => pad + (Math.log10(Math.max(1, n)) / 3) * (W - 2 * pad);
  const top = 26, h = 22;
  const minor: number[] = [];
  for (let d = 1; d < 1000; d *= 10) for (let m = 2; m <= 9; m++) minor.push(d * m);
  return { W, H: top + h + 44, x, top, h, minor, labels };
};
const views = [
  { cls: "wide", ...ruler(880, 12, [1, 5, 10, 20, 50, 100, 500, 1000]) },
  { cls: "narrow", ...ruler(380, 8, [1, 10, 100, 1000]) },
];
const decades = [
  [1, 10],
  [10, 100],
  [100, 1000],
];
const label = lit
  ? `A ruler from one agent to a thousand on a log scale, filled to ${lit} agents at the fleet's latest peak, ${busy} of them busy at once.`
  : "A ruler from one agent to a thousand on a log scale, each tenfold step shaded; nothing is filled until the fleet's first collected reading.";
---

<section class="scale" aria-labelledby="scale-title">
  <div class="head">
    <p class="eyebrow" id="scale-title">One agent to a thousand</p>
    <p class="axis-note">Agents at the fleet's peak, on a log scale</p>
  </div>

  <div class="instrument">
    <div class="read">
      <span class="k">Agents at the peak</span>
      <span class:list={["num", { none: !lit }]}>{lit || "—"}</span>
      <span class="band">{lit ? `at most ${busy} busy at once` : "waits for the first collected reading"}</span>
      {latest && <span class="k when">{iso(latest.date)}</span>}
    </div>
    {
      views.map((v) => (
        <svg class={v.cls} viewBox={`0 0 ${v.W} ${v.H}`} role="img" aria-label={label}>
          <defs>
            <linearGradient id={`sweep-${v.cls}`} x1="0" x2="1" y1="0" y2="0">
              <stop offset="0" stop-color="var(--brass)" stop-opacity="0" />
              <stop offset=".5" stop-color="var(--brass)" stop-opacity=".22" />
              <stop offset="1" stop-color="var(--brass)" stop-opacity="0" />
            </linearGradient>
            <clipPath id={`track-${v.cls}`}>
              <rect x={v.x(1)} y={v.top} width={v.x(1000) - v.x(1)} height={v.h} rx="4" />
            </clipPath>
          </defs>
          {decades.map(([a, b], k) => (
            <>
              <rect class={`decade d${k}`} x={v.x(a)} y={v.top} width={v.x(b) - v.x(a)} height={v.h} />
              <text class="cap" x={(v.x(a) + v.x(b)) / 2} y={v.top - 9} text-anchor="middle">
                {a.toLocaleString("en")} to {b.toLocaleString("en")}
              </text>
            </>
          ))}
          <rect class="track" x={v.x(1)} y={v.top} width={v.x(1000) - v.x(1)} height={v.h} rx="4" />
          <g clip-path={`url(#track-${v.cls})`}>
            <rect class="sweep" x="-140" y={v.top} width="140" height={v.h} fill={`url(#sweep-${v.cls})`} style={`--run:${v.W + 140}px`} />
          </g>
          {v.minor.map((n) => (
            <line class="minor" x1={v.x(n)} x2={v.x(n)} y1={v.top + v.h} y2={v.top + v.h - (n % 5 === 0 && String(n)[0] === "5" ? 8 : 5)} />
          ))}
          {[10, 100].map((n) => (
            <line class="step" x1={v.x(n)} x2={v.x(n)} y1={v.top - 4} y2={v.top + v.h + 4} />
          ))}
          {lit > busy && <rect class="idle" x={v.x(busy || 1)} y={v.top + 5.5} width={v.x(lit) - v.x(busy || 1)} height={v.h - 11} rx="2" />}
          {busy > 0 && <rect class="busy" x={v.x(1)} y={v.top + 5} width={v.x(busy) - v.x(1)} height={v.h - 10} rx="2" />}
          {lit > 0 && <path class="pointer" d={`M${v.x(lit)},${v.top + v.h + 3} l-6,9 h12 z`} />}
          {v.labels.map((m) => (
            <>
              <line class="tick" x1={v.x(m)} x2={v.x(m)} y1={v.top + v.h + 14} y2={v.top + v.h + 20} />
              <text class="lab" x={v.x(m)} y={v.top + v.h + 36} text-anchor={m === 1 ? "start" : m === 1000 ? "end" : "middle"}>
                {m.toLocaleString("en")}
              </text>
            </>
          ))}
        </svg>
      ))
    }
  </div>
  {
    lit > 0 && (
      <p class="key">
        <i class="k-busy" /> busy <i class="k-idle" /> running, not busy
      </p>
    )
  }

  <div class="stand">
    <div>
      <p class="label">You can see it</p>
      <p class="call">The fleet measured, and everything on the record.</p>
    </div>
    <a class="go" href="/fleet/fleet-utilization/">Fleet utilization</a>
  </div>
</section>

<style>
  .scale { margin: 64px 0 0; padding: 28px 24px 22px; border: 1px solid var(--line); border-radius: 14px; background: rgba(9, 28, 31, 0.5); }
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; margin-bottom: 18px; }
  .axis-note { margin: 0; font: 11px/1.6 var(--mono); color: var(--ink-3); }

  /* The reading beside the ruler, as the priming dial reads: a label, the
     number, a line naming the state. */
  .instrument { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 16px 28px; align-items: center; }
  .read { display: grid; gap: 2px; justify-items: start; }
  .k { font: 10.5px/1.5 var(--mono); letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3); }
  .num { font: 700 3rem/1 var(--display); letter-spacing: -0.03em; color: var(--brass); font-variant-numeric: tabular-nums; }
  .num.none { color: var(--ink-3); }
  .band { font: 600 13px/1.35 var(--display); color: var(--ink-2); }
  .when { margin-top: 2px; letter-spacing: 0.08em; }

  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .narrow { display: none; }
  .decade { fill: var(--mint); }
  .d0 { fill-opacity: 0.05; }
  .d1 { fill-opacity: 0.09; }
  .d2 { fill-opacity: 0.13; }
  .track { fill: none; stroke: var(--line); }
  .cap { fill: var(--ink-3); font: 11px var(--mono); }
  .minor { stroke: var(--ink-3); stroke-opacity: 0.55; }
  .step { stroke: var(--bone); stroke-opacity: 0.45; }
  .busy { fill: var(--brass); }
  .idle { fill: none; stroke: var(--brass); stroke-width: 1.3; }
  .pointer { fill: var(--brass); }
  .tick { stroke: var(--line); }
  .lab { fill: var(--ink-3); font: 12px var(--mono); }
  .narrow .lab, .narrow .cap { font-size: 14.5px; }

  .key { margin: 10px 0 0; font: 11px/1.6 var(--mono); color: var(--ink-3); display: flex; gap: 6px 10px; align-items: center; flex-wrap: wrap; }
  .key i { display: inline-block; width: 14px; height: 9px; border-radius: 2px; }
  .k-busy { background: var(--brass); }
  .k-idle { border: 1.3px solid var(--brass); }

  @media (max-width: 40rem) {
    .instrument { grid-template-columns: minmax(0, 1fr); }
    .wide { display: none; }
    .narrow { display: block; }
  }

  /* Momentum: a slow light runs along the track toward the thousand. */
  .sweep { animation: sweep 9s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
  @keyframes sweep { from { transform: translateX(0); } to { transform: translateX(var(--run)); } }
  @media (prefers-reduced-motion: reduce) { .sweep { display: none; } }

  .stand { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 12px 24px; margin-top: 18px; border-top: 1px solid var(--line-soft); padding-top: 16px; }
  .label { margin: 0 0 4px; font: 10.5px/1.5 var(--mono); letter-spacing: 0.2em; text-transform: uppercase; color: var(--mint); }
  .call { margin: 0; font: 500 1.15rem/1.4 var(--display); color: var(--ink); }
  .go { font: 11px/1.6 var(--mono); letter-spacing: 0.16em; text-transform: uppercase; white-space: nowrap; }
  .go::after { content: " →"; }
</style>

---
// The case Home opens on, shown: the limit is one person's attention. On the
// left, nine agents in nine panes and you going from pane to pane, while the
// ones you are not looking at wait on you unseen. On the right, the same
// agents keep working and only their decisions come to you, numbered, on one
// rail, and one word answers them. It is a picture of the way of working, not
// a measurement: no number in it is read from the fleet.
//
// CSS keyframes only, one 16-second loop, so it moves with scripts off; the
// keyframes are written here from the timeline below. A reader who asks for
// reduced motion gets both sides held at one moment, three agents waiting on
// you on the left and three decisions on the rail on the right; a button
// pauses it for anyone else.

const T = 16;
const STILL = 9.2;
const pct = (t: number) => `${+((((t % T) + T) % T) / T * 100).toFixed(3)}%`;
// A keyframes rule from moments: [time in seconds, declarations], times
// within one loop and in order.
const frames = (name: string, at: [number, string][]) =>
  `@keyframes ${name}{${at.map(([t, d]) => `${t >= T ? "100%" : pct(t)}{${d}}`).join("")}}`;

// --- Without a process: nine panes, and you visiting them in turn. ---
const W = 144, H = 96, G = 12, X0 = 12, Y0 = 18;
const panes = [
  { name: "unit/auth", asks: "needs you" },
  { name: "unit/ledger", asks: "asks a question" },
  { name: "unit/export", asks: "tests failed" },
  { name: "fix/flaky-test", asks: "plan to approve" },
  { name: "unit/search", asks: "needs you" },
  { name: "chore/bump-mise", asks: "stuck on a merge" },
  { name: "unit/parquet", asks: "asks a question" },
  { name: "unit/docs", asks: "needs you" },
  { name: "unit/billing", asks: "done, waiting" },
].map((p, i) => ({ ...p, i, x: X0 + (i % 3) * (W + G), y: Y0 + Math.floor(i / 3) * (H + 14) }));

// Where your attention goes, a visit every 1.6 seconds, and how long each
// pane had been waiting on you when you got there.
const visits = [0, 5, 2, 7, 3, 8, 1, 6, 4, 2];
const waited = [3, 4.2, 2.6, 5, 3.4, 4.6, 2.8, 5.4, 6.8, 3.2];
const step = T / visits.length;
const hold = 1.25;

let css = "";
// The ring of your attention jumps from pane to pane.
const at = (i: number) => `transform:translate(${panes[i].x}px,${panes[i].y}px)`;
const ring: [number, string][] = [];
visits.forEach((p, k) => {
  const t = k * step;
  ring.push([t, at(p)], [t + hold, at(p)]);
});
ring.push([T, at(visits[0])]);
css += frames("at-ring", ring);

// A pane waits on you from when it asks until your visit answers it.
const waits = panes.map((p) => {
  const spans = visits.flatMap((v, k) => (v === p.i ? [[k * step - waited[k], k * step + 0.4]] : []));
  // Each span within the loop: one that started before the loop's start
  // wraps round to its end.
  const on: [number, number][] = spans.flatMap(([a, b]) => (a < 0 ? [[0, b], [T + a, T]] : [[a, b]])) as [number, number][];
  on.sort((m, n) => m[0] - n[0]);
  const kf: [number, string][] = [];
  const show = (o: number) => `opacity:${o}`;
  let open = on.some(([a]) => a === 0);
  kf.push([0, show(open ? 1 : 0)]);
  for (const [a, b] of on) {
    if (a > 0) kf.push([a, show(0)], [a + 0.25, show(1)]);
    if (b < T) kf.push([b, show(1)], [b + 0.25, show(0)]);
  }
  open = on.some(([, b]) => b >= T);
  kf.push([T, show(open ? 1 : 0)]);
  css += frames(`at-wait-${p.i}`, kf);
  return `at-wait-${p.i}`;
});

// --- With the Method: the agents at work, and their decisions on a rail. ---
const chips = Array.from({ length: 9 }, (_, i) => ({ x: 12 + i * 50.5, d: 4.5 + ((i * 7) % 9) * 0.6 }));
const decisions = [
  { n: 1, title: "Approve the plan", sub: "CSV export, four units", act: "approve", t: 1 },
  { n: 2, title: "Keep JSON, or move to Parquet?", sub: "a question, worked to a conclusion", act: "choose", t: 3.4 },
  { n: 3, title: "Land bolt/pay", sub: "three units passed the gate", act: "land", t: 5.8 },
];
const go = 10, clear = 12, empty = 12.8;
decisions.forEach((d, k) => {
  css += frames(`at-card-${k}`, [
    [0, "opacity:0;transform:translateY(10px)"],
    [d.t, "opacity:0;transform:translateY(10px)"],
    [d.t + 0.5, "opacity:1;transform:translateY(0)"],
    [clear + k * 0.15, "opacity:1;transform:translateY(0)"],
    [clear + 0.6 + k * 0.15, "opacity:0;transform:translateY(-8px)"],
    [T, "opacity:0;transform:translateY(-8px)"],
  ]);
  const ok = go + 0.4 + k * 0.3;
  css += frames(`at-ok-${k}`, [
    [0, "opacity:0"],
    [ok, "opacity:0"],
    [ok + 0.2, "opacity:1"],
    [T, "opacity:1"],
  ]);
});
css += frames("at-go", [
  [0, "opacity:0"],
  [go, "opacity:0"],
  [go + 0.3, "opacity:1"],
  [clear, "opacity:1"],
  [clear + 0.6, "opacity:0"],
  [T, "opacity:0"],
]);
css += frames("at-empty", [
  [0, "opacity:0"],
  [empty, "opacity:0"],
  [empty + 0.4, "opacity:1"],
  [T - 0.5, "opacity:1"],
  [T, "opacity:0"],
]);
css += "@keyframes at-work{from{transform:scaleX(0.04)}to{transform:scaleX(1)}}";
css += "@keyframes at-pulse{0%,100%{opacity:1}50%{opacity:0.35}}";
css += `@media (prefers-reduced-motion:reduce){.attention *{animation-delay:-${STILL}s!important;animation-play-state:paused!important}}`;
---

<figure class="attention" data-attention aria-label="One person and many agents, two ways">
  <div class="side">
    <p class="kick">Without a process</p>
    <svg viewBox="0 0 480 344" role="img" aria-label="Nine agents, each in its own pane. Your attention jumps from pane to pane; while you answer one, others ask a question, fail a test or wait for a plan to be approved, and wait on you unseen.">
      {
        panes.map((p) => (
          <g>
            <rect class="pane" x={p.x} y={p.y} width={W} height={H} rx="8" />
            <text class="name" x={p.x + 12} y={p.y + 21}>{p.name}</text>
            <circle class="run" cx={p.x + W - 14} cy={p.y + 17} r="3.5" />
            <rect class="log" x={p.x + 12} y={p.y + 33} width={96 + ((p.i * 13) % 24)} height="4" rx="2" />
            <rect class="log" x={p.x + 12} y={p.y + 43} width={64 + ((p.i * 29) % 44)} height="4" rx="2" />
            <rect class="log" x={p.x + 12} y={p.y + 53} width={80 + ((p.i * 17) % 32)} height="4" rx="2" />
            <text class="state" x={p.x + 12} y={p.y + 81}>working</text>
            <g class="wait" style={`animation-name:${waits[p.i]}`}>
              <rect class="wait-edge" x={p.x} y={p.y} width={W} height={H} rx="8" />
              <rect class="wait-bar" x={p.x + 6} y={p.y + 66} width={W - 12} height="22" rx="5" />
              <circle class="wait-dot" cx={p.x + 16} cy={p.y + 77} r="3.5" />
              <text class="wait-text" x={p.x + 25} y={p.y + 81}>{p.asks}</text>
            </g>
          </g>
        ))
      }
      <g class="ring">
        <rect x="-5" y="-5" width={W + 10} height={H + 10} rx="11" />
        <rect class="you" x="-5" y="-17" width="34" height="16" rx="4" />
        <text class="you-text" x="12" y="-5.5" text-anchor="middle">you</text>
      </g>
    </svg>
    <p class="cap">You go from agent to agent, and the ones you are not looking at wait on you unseen.</p>
  </div>

  <div class="turn" aria-hidden="true"><span>→</span></div>

  <div class="side after">
    <p class="kick">With the Method</p>
    <svg viewBox="0 0 480 344" role="img" aria-label="The same nine agents keep working in a row. Their decisions come to you numbered on one rail: approve a plan, choose between JSON and Parquet, land a bolt. One word answers them, and the rail is empty again.">
      <text class="label" x="12" y="14">Agents at work</text>
      {
        chips.map((c) => (
          <g>
            <rect class="chip" x={c.x} y="24" width="44" height="28" rx="6" />
            <circle class="run" cx={c.x + 10} cy="35" r="3" />
            <rect class="track" x={c.x + 7} y="43" width="30" height="3" rx="1.5" />
            <rect class="work" x={c.x + 7} y="43" width="30" height="3" rx="1.5" style={`animation-duration:${c.d}s`} />
          </g>
        ))
      }
      <text class="label" x="12" y="84">Decisions for you</text>
      <rect class="rail" x="12" y="94" width="456" height="240" rx="10" />
      <text class="empty" x="240" y="218" text-anchor="middle" style="animation-name:at-empty">Nothing waits on you.</text>
      {
        decisions.map((d, k) => (
          <g class="card" style={`animation-name:at-card-${k}`}>
            <rect class="card-box" x="24" y={106 + k * 60} width="432" height="50" rx="8" />
            <circle class="num" cx="46" cy={131 + k * 60} r="11" />
            <text class="num-text" x="46" y={135 + k * 60} text-anchor="middle">{d.n}</text>
            <g class="ok" style={`animation-name:at-ok-${k}`}>
              <circle cx="46" cy={131 + k * 60} r="11" />
              <path d={`M40 ${131 + k * 60} l4 4 l8 -8`} />
            </g>
            <text class="title" x="66" y={127 + k * 60}>{d.title}</text>
            <text class="sub" x="66" y={143 + k * 60}>{d.sub}</text>
            <rect class="act" x="380" y={120 + k * 60} width="64" height="22" rx="11" />
            <text class="act-text" x="412" y={135 + k * 60} text-anchor="middle">{d.act}</text>
          </g>
        ))
      }
      <g class="go" style="animation-name:at-go">
        <text class="go-text" x="400" y="310" text-anchor="end">one word answers them</text>
        <rect class="go-pill" x="408" y="296" width="40" height="20" rx="10" />
        <text class="go-word" x="428" y="310" text-anchor="middle">go</text>
      </g>
    </svg>
    <p class="cap">The agents keep working, and only their decisions come to you, numbered, on one rail.</p>
  </div>

  <button type="button" class="toggle" data-toggle aria-pressed="false" hidden>Pause</button>
</figure>
<Fragment set:html={`<style>${css}</style>`} />

<script>
  for (const fig of document.querySelectorAll<HTMLElement>("[data-attention]")) {
    const button = fig.querySelector<HTMLButtonElement>("[data-toggle]")!;
    button.hidden = false;
    button.addEventListener("click", () => {
      const paused = fig.classList.toggle("paused");
      button.textContent = paused ? "Play" : "Pause";
      button.setAttribute("aria-pressed", String(paused));
    });
  }
</script>

<style>
  .attention {
    margin: 40px 0 0; padding: 22px 24px 18px; display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 12px 20px; align-items: start; border: 1px solid var(--ap-line); border-radius: var(--ap-radius); background: var(--ap-bg-2);
  }
  .side { display: grid; gap: 10px; min-width: 0; }
  .kick { margin: 0; font: 500 0.75rem/1.6 var(--ap-font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ap-fg-3); }
  .after .kick { color: var(--ap-accent); }
  .cap { margin: 0; font-size: 0.95rem; line-height: 1.5; color: var(--ap-fg-2); max-width: 40ch; }
  .turn { align-self: center; color: var(--ap-fg-3); font: 1.5rem/1 var(--ap-font-display); }
  svg { display: block; width: 100%; height: auto; overflow: visible; font-family: var(--ap-font-sans); }
  .ring, .wait, .card, .ok, .go, .empty { animation-duration: 16s; animation-timing-function: ease-in-out; animation-iteration-count: infinite; }

  .pane { fill: var(--ap-bg-3); stroke: var(--ap-line); stroke-width: 1.2; }
  .name { font: 500 11px var(--ap-font-mono); fill: var(--ap-fg-2); }
  .run { fill: var(--mint); }
  .log { fill: var(--ap-line); }
  .state { font-size: 11.5px; fill: var(--ap-fg-3); }
  .wait { opacity: 0; }
  /* An agent waiting on you in the family's red, so the gold stays the
     process's alone. */
  .wait-edge { fill: none; stroke: var(--ap-bad); stroke-width: 1.5; }
  .wait-bar { fill: color-mix(in oklab, var(--ap-bad) 14%, var(--ap-bg-3)); }
  .wait-dot { fill: var(--ap-bad); animation: at-pulse 1.2s ease-in-out infinite; }
  .wait-text { font-size: 11.5px; font-weight: 600; fill: var(--ap-bad); }
  .ring { animation-name: at-ring; }
  /* You, in the ink; the brass is the process's, on the right. */
  .ring rect:first-child { fill: none; stroke: var(--ap-fg); stroke-width: 2.5; }
  .you { fill: var(--ap-fg); }
  .you-text { font: 600 10.5px var(--ap-font-mono); fill: var(--ap-bg); }

  .label { font: 500 10.5px var(--ap-font-mono); letter-spacing: 0.08em; text-transform: uppercase; fill: var(--ap-fg-3); }
  .chip { fill: var(--ap-bg-3); stroke: var(--ap-line); stroke-width: 1.2; }
  .track { fill: var(--ap-line); }
  .work { fill: var(--mint); transform-box: fill-box; transform-origin: left; animation: at-work linear infinite; }
  .rail { fill: color-mix(in oklab, var(--ap-fg) 3%, var(--ap-bg-2)); stroke: var(--ap-line-soft); }
  .empty { font-size: 13px; fill: var(--ap-fg-3); opacity: 0; }
  .card { opacity: 0; }
  .card-box { fill: var(--ap-bg-3); stroke: var(--ap-line); stroke-width: 1.2; }
  .num { fill: var(--ap-accent); }
  .num-text { font: 700 12px var(--ap-font-mono); fill: var(--ap-bg); }
  .ok { opacity: 0; }
  .ok circle { fill: var(--ap-ok); }
  .ok path { fill: none; stroke: var(--ap-bg); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .title { font: 600 13.5px var(--ap-font-sans); fill: var(--ap-fg); }
  .sub { font-size: 11.5px; fill: var(--ap-fg-3); }
  .act { fill: none; stroke: var(--ap-fg-3); }
  .act-text { font: 500 11px var(--ap-font-mono); fill: var(--ap-fg-2); }
  .go { opacity: 0; }
  .go-text { font-size: 11.5px; fill: var(--ap-fg-3); }
  .go-pill { fill: var(--ap-accent); }
  .go-word { font: 700 11.5px var(--ap-font-mono); fill: var(--ap-bg); }

  .paused * { animation-play-state: paused !important; }
  .toggle {
    all: unset; cursor: pointer; grid-column: 1 / -1; justify-self: end; font: 11px/1.6 var(--ap-font-mono);
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--ap-fg-3);
  }
  .toggle[hidden] { display: none; }
  .toggle:hover { color: var(--ap-fg); }
  .toggle:focus-visible { outline: 2px solid var(--ap-accent); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .toggle { display: none; } }

  /* A narrow screen: one way above the other. */
  @media (max-width: 56rem) {
    .attention { grid-template-columns: minmax(0, 1fr); padding: 14px 12px; }
    .turn { justify-self: center; transform: rotate(90deg); }
  }
</style>

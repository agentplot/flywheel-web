---
import { type Day, fmt, share, short } from "./utilization";

// Agents like cores: each day's bar is the median of agents running, the
// busy ones solid and the rest hollow. Each count's band rises from its
// median to the day's peak, the peak its upper edge. The host's CPU, memory
// and processes run underneath on the same days, so a column reads as one
// instant. Drawn at build time; the script only picks a day and switches to
// busy as a share of running.

interface Props {
  days: Day[];
}
const { days } = Astro.props;
const n = days.length;

const W = 760, L = 48, R = 12;
const band = (W - L - R) / n;
const bar = Math.min(22, band * 0.62);
const thin = Math.max(4, bar * 0.34);
const cx = (i: number) => L + band * (i + 0.5);

// The agents panel.
const aTop = 40, aBottom = 250;
const step = (max: number, count: number) => {
  const raw = max / count;
  const mag = 10 ** Math.floor(Math.log10(raw));
  const f = raw / mag;
  return Math.max(1, (f <= 1 ? 1 : f <= 2 ? 2 : f <= 5 ? 5 : 10) * mag);
};
const aMaxRaw = Math.max(...days.map((d) => d.running.peak));
const aStep = step(aMaxRaw, 5);
const aMax = Math.ceil(aMaxRaw / aStep) * aStep;
const ya = (v: number) => aBottom - (v / aMax) * (aBottom - aTop);
const aTicks = Array.from({ length: aMax / aStep + 1 }, (_, i) => i * aStep);
const ys = (pct: number) => aBottom - (pct / 100) * (aBottom - aTop);

// The host's strips, under the agents: a median each, no peak.
const roundUp = (v: number) => {
  const unit = 10 ** Math.floor(Math.log10(v)) / 2;
  return Math.ceil(v / unit) * unit;
};
const stripH = 72, stripGap = 46, firstStrip = aBottom + 56;
const strips = [
  { key: "cpu", label: "CPU", unit: "percent", color: "var(--rust)", max: 100 },
  { key: "memory", label: "Memory", unit: "GB", color: "var(--mint)", max: 0 },
  { key: "processes", label: "Processes", unit: "processes", color: "var(--ap-fg)", max: 0 },
] as const;
const drawn = strips.map((s, k) => {
  const top = firstStrip + k * (stripH + stripGap);
  const bottom = top + stripH;
  const max = s.max || roundUp(Math.max(...days.map((d) => d[s.key])));
  const y = (v: number) => bottom - (v / max) * stripH;
  const line = days.map((d, i) => `${i ? "L" : "M"}${cx(i).toFixed(1)},${y(d[s.key]).toFixed(1)}`).join("");
  return { ...s, top, bottom, max, y, line };
});
const H = drawn[drawn.length - 1].bottom + 30;

// Label every seventh day, counting back from the latest.
const labelled = days.map((_, i) => (n - 1 - i) % 7 === 0);
const anySample = days.some((d) => d.sample);
const latest = days[n - 1];
const summary =
  `Agents running and busy each day for ${n} days, to ${latest.date}, each a median with the day's peak, ` +
  `and the host's CPU, memory and processes on the same days.` +
  (anySample ? " Every point shown is a sample." : "");
const title = (d: Day) =>
  `${d.date}${d.sample ? " (sample)" : ""}: agents running ${d.running.median}, peak ${d.running.peak}; ` +
  `busy ${d.busy.median}, peak ${d.busy.peak}; busy share ${share(d, "median")}% of the medians, ` +
  `${share(d, "peak")}% of the peaks; CPU ${fmt.cpu(d.cpu)}, memory ${fmt.memory(d.memory)}, ` +
  `${fmt.processes(d.processes)} processes (medians)`;
---

<figure class="uchart" data-mode="agents" data-uchart>
  <div class="head">
    <ul class="legend agents-only" aria-label="Legend">
      <li><i class="sw busy"></i>busy</li>
      <li><i class="sw idle"></i>running, not busy</li>
      <li><i class="sw band"></i>up to the day's peak</li>
      <li><i class="sw thin"></i>busy, up to its peak</li>
      {anySample && <li><i class="sw hatch"></i>hatched or dashed: a sample</li>}
    </ul>
    <ul class="legend share-only" aria-label="Legend">
      <li><i class="sw busy"></i>busy ÷ running, of the medians</li>
      <li><i class="sw peak"></i>of the peaks</li>
      {anySample && <li><i class="sw hatch"></i>hatched: a sample</li>}
    </ul>
    <div class="modes" role="group" aria-label="Show" hidden>
      <button type="button" data-mode="agents" aria-pressed="true">Agents</button>
      <button type="button" data-mode="share" aria-pressed="false">Busy share</button>
    </div>
  </div>
  <p class="medians">Each count is the day's median, every 5-minute sample counted.</p>

  <div class="scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={summary} tabindex="0">
      <defs>
        <pattern id="u-hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <rect width="1.8" height="5" fill="var(--ap-bg)" opacity=".7"></rect>
        </pattern>
      </defs>

      {days.map((_, i) => <rect class="cursor" data-i={i} x={L + band * i + 1} y={aTop - 8} width={band - 2} height={H - 28 - (aTop - 8)} rx="3" />)}

      <g class="axis">
        <text class="cap" x={0} y={aTop - 22}>Agents</text>
        <g class="agents-only">
          {aTicks.map((t) => (
            <>
              <line x1={L} x2={W - R} y1={ya(t)} y2={ya(t)} />
              <text x={L - 10} y={ya(t) + 4} text-anchor="end">{t}</text>
            </>
          ))}
        </g>
        <g class="share-only">
          {[0, 25, 50, 75, 100].map((t) => (
            <>
              <line x1={L} x2={W - R} y1={ys(t)} y2={ys(t)} />
              <text x={L - 10} y={ys(t) + 4} text-anchor="end">{t}%</text>
            </>
          ))}
        </g>
      </g>

      <g class="agents-only">
        {
          days.map((d, i) => {
            const x = cx(i) - bar / 2;
            const busyTop = ya(d.busy.median);
            const runTop = ya(d.running.median);
            const runPeak = ya(d.running.peak);
            const busyPeak = ya(d.busy.peak);
            return (
              <g>
                <rect class="band" x={x} y={runPeak} width={bar} height={runTop - runPeak} />
                <line class="peak" x1={x} x2={x + bar} y1={runPeak} y2={runPeak} />
                <rect class="idle" x={x + 0.75} y={runTop + 0.75} width={bar - 1.5} height={Math.max(0, busyTop - runTop - 2.5)} rx="2" />
                <rect class="busy" x={x} y={busyTop} width={bar} height={aBottom - busyTop} rx="2" />
                {d.sample && <rect fill="url(#u-hatch)" x={x} y={runTop} width={bar} height={aBottom - runTop} rx="2" />}
                <rect class="thin" x={cx(i) - thin / 2} y={busyPeak} width={thin} height={Math.max(0, busyTop - busyPeak)} />
                <line class="thin-peak" x1={cx(i) - thin / 2 - 1.5} x2={cx(i) + thin / 2 + 1.5} y1={busyPeak} y2={busyPeak} />
              </g>
            );
          })
        }
      </g>

      <g class="share-only">
        {
          days.map((d, i) => {
            const x = cx(i) - bar / 2;
            const top = ys(share(d, "median"));
            const peak = ys(share(d, "peak"));
            return (
              <g>
                <rect class="capacity" x={x} y={aTop} width={bar} height={aBottom - aTop} rx="2" />
                <rect class="busy" x={x} y={top} width={bar} height={aBottom - top} rx="2" />
                {d.sample && <rect fill="url(#u-hatch)" x={x} y={top} width={bar} height={aBottom - top} rx="2" />}
                <line class="peak" x1={x - 3} x2={x + bar + 3} y1={peak} y2={peak} />
              </g>
            );
          })
        }
      </g>

      {
        drawn.map((s) => (
          <g class="strip">
            <text class="cap" x={0} y={s.top - 16}>
              {s.label} <tspan class="unit">· {s.unit}, median</tspan>
            </text>
            <line class="base" x1={L} x2={W - R} y1={s.bottom} y2={s.bottom} />
            <line class="grid" x1={L} x2={W - R} y1={s.top} y2={s.top} />
            <text x={L - 10} y={s.top + 4} text-anchor="end">{s.key === "cpu" ? "100%" : s.max.toLocaleString("en")}</text>
            <text x={L - 10} y={s.bottom + 4} text-anchor="end">0</text>
            <path d={`${s.line}L${cx(n - 1).toFixed(1)},${s.bottom}L${cx(0).toFixed(1)},${s.bottom}Z`} fill={s.color} class="area" />
            <path d={s.line} stroke={s.color} class:list={["median", { dashed: anySample }]} />
            {days.map((d, i) => <circle cx={cx(i)} cy={s.y(d[s.key])} r="2.6" stroke={s.color} class:list={["dot", { hollow: d.sample }]} fill={s.color} />)}
          </g>
        ))
      }

      <g class="axis">
        {days.map((d, i) => labelled[i] && <text x={cx(i)} y={H - 10} text-anchor="middle">{short(d.date)}</text>)}
      </g>

      {
        days.map((d, i) => (
          <rect class="hit" data-i={i} x={L + band * i} y={aTop - 8} width={band} height={H - 28 - (aTop - 8)}>
            <title>{title(d)}</title>
          </rect>
        ))
      }
    </svg>
  </div>
  <script type="application/json" data-days set:html={JSON.stringify(days)} />
</figure>

<script>
  // Picking a day lights its column and tells the page; the tiles listen.
  for (const fig of document.querySelectorAll<HTMLElement>("[data-uchart]")) {
    const days = JSON.parse(fig.querySelector("[data-days]")!.textContent!);
    const svg = fig.querySelector("svg")!;
    const cursors = [...fig.querySelectorAll<SVGRectElement>(".cursor")];
    // A phone scrolls the chart; open it on the latest day.
    const scroller = fig.querySelector<HTMLElement>(".scroll")!;
    scroller.scrollLeft = scroller.scrollWidth;
    let picked = days.length - 1;
    const pick = (i: number) => {
      picked = Math.max(0, Math.min(days.length - 1, i));
      cursors.forEach((c, n) => c.classList.toggle("on", n === picked));
      document.dispatchEvent(new CustomEvent("fleet:pick", { detail: { day: days[picked], latest: picked === days.length - 1 } }));
    };
    for (const hit of fig.querySelectorAll<SVGRectElement>(".hit")) {
      const i = Number(hit.dataset.i);
      hit.addEventListener("pointerenter", () => pick(i));
      hit.addEventListener("click", () => pick(i));
    }
    svg.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") pick(picked - 1);
      else if (e.key === "ArrowRight") pick(picked + 1);
      else if (e.key === "End") pick(days.length - 1);
      else if (e.key === "Home") pick(0);
      else return;
      e.preventDefault();
    });
    document.addEventListener("fleet:latest", () => pick(days.length - 1));

    const modes = fig.querySelector<HTMLElement>(".modes")!;
    modes.hidden = false;
    for (const b of modes.querySelectorAll<HTMLButtonElement>("button")) {
      b.addEventListener("click", () => {
        fig.dataset.mode = b.dataset.mode;
        for (const o of modes.querySelectorAll("button")) o.setAttribute("aria-pressed", String(o === b));
      });
    }
  }
</script>

<style>
  .uchart { margin: 0; min-width: 0; }
  .head { display: flex; flex-wrap: wrap; gap: 10px 20px; align-items: center; justify-content: space-between; }
  .legend { display: flex; flex-wrap: wrap; gap: 6px 18px; list-style: none; margin: 0; padding: 0; font: 11.5px/1.5 var(--ap-font-mono); color: var(--ap-fg-3); }
  .legend li { display: flex; align-items: center; gap: 7px; }
  .medians { margin: 6px 0 8px; font: 11.5px/1.5 var(--ap-font-mono); color: var(--ap-fg-3); }
  .sw { display: inline-block; width: 12px; height: 12px; border-radius: 2px; }
  .sw.busy { background: var(--ap-accent); }
  .sw.idle { border: 1.5px solid var(--mint); background: color-mix(in oklab, var(--mint) 14%, transparent); }
  .sw.band { background: color-mix(in oklab, var(--mint) 16%, transparent); border-top: 2px solid var(--ap-fg); border-radius: 0; }
  .sw.thin { width: 5px; background: color-mix(in oklab, var(--ap-accent) 45%, transparent); border-top: 2px solid var(--ap-accent); border-radius: 0; }
  .sw.peak { height: 2px; background: var(--ap-fg); }
  .sw.hatch { background: repeating-linear-gradient(45deg, var(--ap-accent) 0 3px, var(--ap-bg) 3px 5px); }
  .modes { display: inline-flex; border: 1px solid var(--ap-line); border-radius: 999px; overflow: hidden; }
  .modes[hidden] { display: none; }
  .modes button {
    all: unset; cursor: pointer; padding: 6px 14px;
    font: 11px/1.4 var(--ap-font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ap-fg-3);
  }
  .modes button[aria-pressed="true"] { background: var(--ap-accent); color: var(--ap-bg); }
  .modes button:focus-visible { outline: 2px solid var(--ap-accent); outline-offset: -2px; }

  .uchart[data-mode="agents"] .share-only, .uchart[data-mode="share"] .agents-only { display: none; }

  /* The chart keeps its proportions; a phone scrolls it, never the page. */
  .scroll { overflow-x: auto; overscroll-behavior-x: contain; }
  svg { display: block; width: 100%; min-width: 600px; height: auto; font-family: var(--ap-font-mono); }
  svg:focus-visible { outline: 2px solid var(--ap-accent); outline-offset: 4px; border-radius: 6px; }
  svg text { fill: var(--ap-fg-3); font-size: 11px; }
  svg .cap { fill: var(--ap-fg-3); font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; }
  svg .cap .unit { fill: var(--ap-fg-3); letter-spacing: 0.06em; text-transform: none; }
  svg .axis line, svg .grid { stroke: var(--ap-line-soft); }
  svg .base { stroke: var(--ap-line); }

  svg .busy { fill: var(--ap-accent); }
  svg .idle { fill: color-mix(in oklab, var(--mint) 14%, transparent); stroke: var(--mint); stroke-width: 1.5; }
  svg .band { fill: color-mix(in oklab, var(--mint) 16%, transparent); }
  svg .peak { stroke: var(--ap-fg); stroke-width: 2; stroke-linecap: round; }
  svg .thin { fill: color-mix(in oklab, var(--ap-accent) 45%, transparent); }
  svg .thin-peak { stroke: var(--ap-accent); stroke-width: 2; stroke-linecap: round; }
  svg .capacity { fill: color-mix(in oklab, var(--mint) 10%, transparent); }

  svg .area { fill-opacity: 0.1; }
  svg .median { fill: none; stroke-width: 1.6; }
  svg .median.dashed { stroke-dasharray: 5 4; }
  svg .dot.hollow { fill: var(--ap-bg); stroke-width: 1.4; }

  svg .cursor { fill: color-mix(in oklab, var(--mint) 8%, transparent); opacity: 0; transition: opacity 0.12s; }
  svg .cursor.on { opacity: 1; }
  svg .hit { fill: transparent; cursor: crosshair; }
  @media (prefers-reduced-motion: reduce) { svg .cursor { transition: none; } }
</style>

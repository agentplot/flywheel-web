---
import FamilyBar from "@agentplot/site-theme/FamilyBar.astro";
import FamilyFooter from "@agentplot/site-theme/FamilyFooter.astro";
import { url } from "../lib/url";
import "../styles/site.css";

interface Props {
  title: string;
  description?: string;
  // Widens the page for numbers set beside prose, such as a measurement.
  wide?: boolean;
  // The family at the foot of the page; the Tools hub, which is the family,
  // leaves it out.
  family?: boolean;
}
const { title, description, wide = false, family = true } = Astro.props;
// The family's bar, footer and diagram come from @agentplot/site-theme and
// wear the flywheel's palette (site.css). The site has one theme, so <html>
// says dark and the family's tokens never follow a light setting.
const here = Astro.url.pathname;
const sections = [
  { href: url("/method/"), label: "The Method" },
  { href: url("/fleet/"), label: "The Fleet" },
  { href: url("/notes/"), label: "Notes" },
  { href: url("/uses/"), label: "Uses" },
  { href: url("/about/"), label: "About" },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === "Flywheel" ? title : `${title} · Flywheel`}</title>
    {description && <meta name="description" content={description} />}
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='13' fill='none' stroke='%238FB9AE' stroke-width='2'/%3E%3Ccircle cx='16' cy='16' r='7.5' fill='none' stroke='%23C9A227' stroke-width='2'/%3E%3Ccircle cx='16' cy='16' r='2.5' fill='%23B4552D'/%3E%3C/svg%3E"
    />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={url("/fonts/space-grotesk-latin-700-normal.woff2")} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={url("/fonts/ibm-plex-mono-latin-400-normal.woff2")} />
  </head>
  <body class:list={[{ wide }]}>
    <FamilyBar current="flywheel" />
    <header class="topbar">
      <div class="bar">
        <a class="mark" href={url("/")}>Fly<span>wheel</span></a>
        <nav aria-label="Sections">
          {
            sections.map((s) => (
              <a href={s.href} aria-current={here.startsWith(s.href) ? "page" : undefined}>
                {s.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      {family && <FamilyFooter current="flywheel" />}
      <p class="colophon">Learning in public how to run a fleet of coding agents.</p>
    </footer>
  </body>
</html>

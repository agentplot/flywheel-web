---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Flywheel from "../components/Flywheel.astro";
import Journey from "../components/Journey.astro";

const principles = (await getCollection("principles", ({ data }) => data.status !== "retired" && data.order > 0)).sort(
  (a, b) => a.data.order - b.data.order,
);
const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latest = notes[0];
---

<Base title="Flywheel" description="Every day the same, for developers and agents: the Method for running a fleet of coding agents, from one agent to a thousand." wide>
  <section class="fold">
    <div class="copy">
      <p class="eyebrow">Flywheel · the Method</p>
      <h1>Every day the same, <span>for developers and agents.</span></h1>
      <p class="deck">
        We are learning in public how to run a fleet of coding agents, from one agent to a thousand. The{" "}
        <a href="/method/">Method</a> is the mental model, the <a href="/notes/">notes</a> are the evidence, and{" "}
        <a href="/fleet/">the Fleet</a> is the numbers.
      </p>
    </div>
    <div class="stage"><Flywheel /></div>
    <ol class="principles" aria-label="The principles">
      {
        principles.map((p) => (
          <li>
            <a href={`/method/${p.id}/`}>
              <span class="no">{String(p.data.order).padStart(2, "0")}</span>
              <span class="t">{p.data.title}</span>
              <span class="l">{p.data.line}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <Journey />

  <section class="after">
    <div class="panel">
      <p class="eyebrow">Latest field note</p>
      {
        latest ? (
          <p>
            <a href={`/notes/${latest.id}/`}>{latest.data.title}</a>
          </p>
        ) : (
          <p class="muted">The first field note is on its way.</p>
        )
      }
    </div>
    <div class="panel">
      <p class="eyebrow">Follow along</p>
      <p class="muted">[Newsletter signup goes here once the platform is chosen.]</p>
    </div>
  </section>
</Base>

<style>
  /* Two columns on a wide screen, the flywheel beside the principles; on a
     phone the flywheel sits between the line and the list. */
  .fold {
    display: grid; gap: 8px 40px; align-items: start;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    grid-template-areas: "copy stage" "list stage";
  }
  .copy { grid-area: copy; }
  .stage { grid-area: stage; position: sticky; top: 64px; }
  .principles { grid-area: list; }
  @media (max-width: 56rem) {
    .fold { grid-template-columns: 1fr; grid-template-areas: "copy" "stage" "list"; }
    .stage { position: static; }
  }

  h1 { font-size: clamp(2.4rem, 5vw, 3.8rem); line-height: 0.98; margin: 12px 0 18px; }
  h1 span { color: var(--brass); }
  .deck { max-width: 40ch; margin: 0 0 8px; }

  .principles { list-style: none; margin: 16px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .principles li { border-bottom: 1px solid var(--line-soft); }
  .principles a {
    display: grid; grid-template-columns: 2.4rem 1fr; gap: 0 4px; padding: 12px 8px 12px 0;
    text-decoration: none; border-left: 2px solid transparent; transition: border-color 0.15s, background 0.15s;
  }
  .principles a:hover, .principles a:focus-visible { border-left-color: var(--brass); background: rgba(201, 162, 39, 0.05); }
  .no { grid-row: span 2; padding: 3px 0 0 10px; font: 11px/1.6 var(--mono); letter-spacing: 0.12em; color: var(--brass); }
  .t { font: 500 1.08rem/1.3 var(--display); color: var(--ink); letter-spacing: -0.01em; }
  .l { font-size: 15.5px; line-height: 1.45; color: var(--ink-3); }
  @media (prefers-reduced-motion: reduce) { .principles a { transition: none; } }

  .after { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); margin-top: 56px; }
  .after .panel { padding: 16px 18px 6px; }
  .after p { margin: 6px 0 10px; }
</style>

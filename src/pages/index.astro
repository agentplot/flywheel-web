---
import { url } from "../lib/url";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Attention from "../components/Attention.astro";
import Benefits from "../components/Benefits.astro";
import FleetReading from "../components/FleetReading.astro";

const notes = (await getCollection("notes", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Base title="Flywheel" description="One person can follow only so many coding agents. Flywheel is the process that keeps them working and brings you only the decisions, on one rail." wide>
  {/* The case first: the limit is one person's attention, and the answer is a
      process, shown before anything the Method buys. */}
  <section class="fold">
    <p class="eyebrow">A people and process problem</p>
    <h1>Agents scale. <span>Your attention doesn't.</span></h1>
    <div class="under">
      <p class="deck">
        One person can keep only so many agents in mind, and jumping between their panes to find the one that
        needs you is chaos. Flywheel is the process that keeps the work running and brings you only the decisions,
        on one rail.
      </p>
      <div class="ctas">
        <a class="cta primary" href={url("/method/")}>Read the Method</a>
        <a class="cta" href={url("/fleet/fleet-utilization/")}>Fleet utilization</a>
      </div>
    </div>
    <Attention />
  </section>

  <h2 class="buys">What the Method buys</h2>
  <Benefits />

  <FleetReading />

  <section class="notes" aria-labelledby="notes-title">
    <div class="notes-head">
      <h2 id="notes-title">Field notes</h2>
      <a class="all" href={url("/notes/")}>All field notes</a>
    </div>
    {
      notes.length ? (
        <ul class="plain">
          {notes.map((n) => (
            <li>
              <span class="when">
                {iso(n.data.date)} · {n.data.kind}
              </span>
              <a href={url(`/notes/${n.id}/`)}>{n.data.title}</a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">The first field note is being written. Each one is dated, cites what it measured, and is never rewritten.</p>
      )
    }
    <p class="signup muted">[Newsletter signup goes here once the platform is chosen.]</p>
  </section>
</Base>

<style>
  /* The headline, then its deck and calls to action side by side. */
  .under { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 18px 40px; }
  h1 { font-size: clamp(2.5rem, 5.5vw, 4.2rem); line-height: 1; margin: 12px 0 20px; }
  h1 span { display: block; color: var(--ap-accent); }
  .deck { max-width: 52ch; margin: 0; font-size: 1.1rem; }
  .buys { margin: 72px 0 0; }

  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  /* The calls to action in the family's pill: the accent filled, or
     outlined in the ink, as Starlight's link buttons are. */
  .cta {
    display: inline-flex; align-items: center; gap: 0.5em; padding: 0.4375rem 1.125rem;
    border: 1px solid var(--ap-fg-3); border-radius: 999rem;
    font-size: 0.875rem; line-height: 1.1875; color: var(--ap-fg); text-decoration: none;
  }
  .cta:hover { color: var(--ap-fg); border-color: var(--ap-fg); }
  .cta.primary { background: var(--ap-accent); border-color: var(--ap-accent); color: var(--ap-bg); }
  .cta.primary:hover { color: var(--ap-bg); }
  .cta.primary::after { content: "→"; }
  @media (min-width: 50rem) { .cta { font-size: 1rem; padding: 0.9375rem 1.25rem; } }

  .notes { margin-top: 64px; max-width: 46rem; }
  .notes-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .notes h2 { margin: 0; }
  .all { font: 11px/1.6 var(--ap-font-mono); letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; }
  .all::after { content: " →"; }
  .notes li { display: grid; gap: 2px; }
  .when { font: 11px/1.6 var(--ap-font-mono); letter-spacing: 0.1em; color: var(--ap-fg-3); }
  .signup { font-size: 15px; margin-top: 24px; }
</style>

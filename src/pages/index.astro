---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Benefits from "../components/Benefits.astro";
import Scale from "../components/Scale.astro";

const notes = (await getCollection("notes", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Base title="Flywheel" description="Scaling a fleet of coding agents from one agent toward a thousand, and the Method that keeps it turning." wide>
  <section class="fold">
    <p class="eyebrow">Flywheel</p>
    <h1>From one agent <span>to a thousand.</span></h1>
    <div class="under">
      <p class="deck">
        We run a fleet of coding agents and keep adding to it, to find out how far one team can take it. What holds
        as the fleet grows becomes the Method; what we measure on the way, we publish.
      </p>
      <div class="ctas">
        <a class="cta primary" href="/method/">Read the Method</a>
        <a class="cta" href="/fleet/fleet-utilization/">Fleet utilization</a>
      </div>
    </div>
  </section>

  <Benefits />

  <Scale />

  <section class="notes" aria-labelledby="notes-title">
    <div class="notes-head">
      <h2 id="notes-title">Field notes</h2>
      <a class="all" href="/notes/">All field notes</a>
    </div>
    {
      notes.length ? (
        <ul class="plain">
          {notes.map((n) => (
            <li>
              <span class="when">
                {iso(n.data.date)} · {n.data.kind}
              </span>
              <a href={`/notes/${n.id}/`}>{n.data.title}</a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">The first field note is being written. Each one is dated, cites what it measured, and is never rewritten.</p>
      )
    }
    <p class="signup muted">[Newsletter signup goes here once the platform is chosen.]</p>
  </section>
</Base>

<style>
  /* The headline, then its deck and calls to action side by side. */
  .under { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 18px 40px; }
  h1 { font-size: clamp(2.6rem, 6vw, 4.6rem); line-height: 0.95; margin: 12px 0 20px; }
  h1 span { color: var(--brass); }
  .deck { max-width: 48ch; margin: 0; font-size: 1.1rem; }

  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .cta {
    font: 500 15px/1 var(--display); text-decoration: none; padding: 13px 20px; border-radius: 8px;
    border: 1px solid var(--line); color: var(--ink); transition: border-color 0.15s, background 0.15s;
  }
  .cta:hover { border-color: var(--mint); color: var(--ink); }
  .cta.primary { background: var(--brass); border-color: var(--brass); color: var(--ground); font-weight: 700; }
  .cta.primary:hover { background: #d8b13a; color: var(--ground); }
  .cta.primary::after { content: " →"; }
  @media (prefers-reduced-motion: reduce) { .cta { transition: none; } }

  .notes { margin-top: 64px; max-width: 46rem; }
  .notes-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .notes h2 { margin: 0; }
  .all { font: 11px/1.6 var(--mono); letter-spacing: 0.16em; text-transform: uppercase; white-space: nowrap; }
  .all::after { content: " →"; }
  .notes li { display: grid; gap: 2px; }
  .when { font: 11px/1.6 var(--mono); letter-spacing: 0.1em; color: var(--ink-3); }
  .signup { font-size: 15px; margin-top: 24px; }
</style>

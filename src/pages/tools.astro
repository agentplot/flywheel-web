---
import { url } from "../lib/url";
import { getEntry } from "astro:content";
import { family, type MemberId, type Place, type Status } from "@agentplot/site-theme";
import Family from "@agentplot/site-theme/Family.astro";
import Base from "../layouts/Base.astro";

// The Flywheel family's hub, where every family site's footer links: the
// loop drawn, a card per member of the family's one list
// (@agentplot/site-theme), then how the tools stand alone and how the Method
// joins them. The words are src/content/pages/tools.md: its opening is the
// lede, and each of its sections a column.

const page = await getEntry("pages", "tools");
if (!page) throw new Error("the Tools hub reads src/content/pages/tools.md, which is missing");
const html = page.rendered?.html ?? "";
const cut = html.search(/<h2[\s>]/);
// A member's accent in both themes; the page's styles pick one.
const pair = (a: { light: string; dark: string }) => `--m-light:${a.light};--m-dark:${a.dark}`;
// A tool named in the prose takes its dot and accent, as on its card.
const named = (h: string) =>
  family.reduce(
    (out, m) => out.replaceAll(`<strong>${m.name}</strong>`, `<strong class="named" style="${pair(m.accent)}">${m.name}</strong>`),
    h,
  );
const lede = cut < 0 ? html : html.slice(0, cut);
const sections = cut < 0 ? [] : named(html.slice(cut)).split(/(?=<h2[\s>])/);

// The loop's places, in the order it runs.
const places: { id: Place; label: string }[] = [
  { id: "notice", label: "Notice" },
  { id: "inbox", label: "Inbox" },
  { id: "launch", label: "Launch" },
  { id: "work", label: "Work" },
  { id: "land", label: "Land" },
  { id: "deliver", label: "Deliver" },
];
const placeOf = (p: Place) => places.find((x) => x.id === p)?.label ?? p;

// The principle of the Method each tool carries; Flywheel carries all of
// them. A principle that is gone, or whose strip does not name the tool,
// fails the build.
const serves: Partial<Record<MemberId, string>> = {
  headwater: "capture-at-the-source",
  eddy: "capture-at-the-source",
  millpond: "capture-at-the-source",
  // A place per launch: one agent in its own worktree, submitting to sluice.
  flume: "one-agent-one-worktree",
  // The one principle whose strip names sounding: what it records is read
  // by the collectors that measure the fleet.
  sounding: "measure-the-fleet",
  sluice: "order-at-landing",
};
const principle = async (tool: string, id: string) => {
  const p = await getEntry("principles", id);
  if (!p) throw new Error(`the Tools hub names the principle "${id}", which is missing`);
  if (!p.data.tools.some((t) => t.name === tool)) {
    throw new Error(`the Tools hub has ${tool} carry "${id}", whose strip does not name ${tool}`);
  }
  return { href: url(`/method/#${id}`), title: p.data.title };
};

const umbrella = family.find((m) => m.place === "umbrella");
if (!umbrella) throw new Error("the family has no umbrella member");
const tools = await Promise.all(
  family
    .filter((m) => m.place !== "umbrella")
    .map(async (m) => ({ m, serves: serves[m.id] ? await principle(m.name, serves[m.id]!) : undefined })),
);
const list = (names: string[]) => (names.length < 2 ? names.join("") : `${names.slice(0, -1).join(", ")} and ${names.at(-1)}`);
const byStatus = (s: Status) => list(tools.filter((t) => t.m.status === s).map((t) => t.m.name));
const built = byStatus("in use"), designed = byStatus("designed, not built");
// The headline counts the tools, so a new member changes it too. The cards
// run in one row up to five, and in two rows beyond.
const cols = tools.length <= 5 ? tools.length : Math.ceil(tools.length / 2);
const counted = ["No", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine"][tools.length] ?? String(tools.length);
---

<Base title={page.data.title} description={page.data.description} wide family={false}>
  <header class="opening">
    <p class="eyebrow">Tools · the Flywheel family</p>
    <h1>{counted} tools, <span>one loop.</span></h1>
    <div class="under">
      <div class="deck" set:html={lede} />
      <dl class="legend" aria-label="Status">
        {built && (<div><dt><span class="dot" aria-hidden="true" />In use</dt><dd>{built}</dd></div>)}
        {designed && (<div><dt><span class="dot planned" aria-hidden="true" />Designed, not built</dt><dd>{designed}</dd></div>)}
      </dl>
    </div>
  </header>

  <Family highlight="flywheel" class="loop" />

  <section class="family" aria-labelledby="family-title">
    <h2 id="family-title">The family</h2>

    <article class="card umbrella" style={pair(umbrella.accent)}>
      <div class="who">
        <p class="place">The Method and its engine</p>
        <h3>{umbrella.name}</h3>
        <p class:list={["status", { planned: umbrella.status !== "in use" }]}><span class="dot" aria-hidden="true" />{umbrella.status}</p>
      </div>
      <div class="what">
        <ol class="track all" style={`--n:${places.length}`} aria-label="Its place: the whole loop">
          {places.map((p) => <li class="on">{p.label}</li>)}
        </ol>
        <p class="line">{umbrella.line}</p>
        <p class="links">
          <a class="go" href={url("/method/")}>Read the Method</a>
        </p>
      </div>
    </article>

    <ul class="tools" style={`--cols:${cols}`}>
      {
        tools.map(({ m, serves }) => (
          <li class="card" style={pair(m.accent)}>
            <ol class="track" style={`--n:${places.length}`} aria-label={`Its place in the loop: ${placeOf(m.place)}`}>
              {places.map((p) => (
                <li class:list={{ on: p.id === m.place }} aria-current={p.id === m.place ? "step" : undefined}>
                  {p.label}
                </li>
              ))}
            </ol>
            <h3>
              <a href={m.site}>{m.name}</a>
            </h3>
            <p class:list={["status", { planned: m.status !== "in use" }]}>
              <span class="dot" aria-hidden="true" />
              {m.status}
            </p>
            <p class="line">{m.line}</p>
            {serves && (
              <p class="serves">
                <span>In the Method</span>
                <a href={serves.href}>{serves.title}</a>
              </p>
            )}
            <p class="links">
              <a href={m.site}>Site</a>
              <a href={m.book}>Design book</a>
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="joined" aria-label="Alone, and joined">
    {sections.map((s) => <div class="col" set:html={s} />)}
  </section>
</Base>

<style>
  /* A member's accent, in the reader's theme. */
  .card, :global(.named) { --m: var(--m-dark); }
  :global(:root[data-theme="light"]) .card, :global(:root[data-theme="light"] .named) { --m: var(--m-light); }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) .card, :global(:root:not([data-theme]) .named) { --m: var(--m-light); }
  }
  .opening { padding-bottom: 40px; }
  h1 { font-size: clamp(2.6rem, 6vw, 4.6rem); line-height: 0.95; margin: 12px 0 20px; }
  h1 span { color: var(--ap-accent); }
  .under { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 18px 40px; }
  .deck { max-width: 48ch; }
  .deck :global(p) { margin: 0; font-size: 1.1rem; }

  /* The status of every tool, read from the family's list. */
  .legend { margin: 0; display: grid; grid-template-columns: auto auto; justify-content: start; gap: 6px 14px; font: 12px/1.6 var(--ap-font-mono); }
  .legend div { display: contents; }
  .legend dt { display: flex; align-items: center; gap: 8px; color: var(--ap-fg-3); letter-spacing: 0.08em; text-transform: uppercase; font-size: 11px; }
  .legend dd { margin: 0; color: var(--ap-fg); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--m, var(--ap-fg-3)); flex: none; }
  .dot.planned, .planned .dot { background: transparent; box-shadow: inset 0 0 0 1.5px var(--m, var(--ap-fg-3)); }

  .family { margin-top: 72px; }
  .family > h2 { margin: 0 0 20px; }

  /* A card per member, ruled in its accent. */
  .card {
    position: relative; border: 1px solid var(--ap-line); border-radius: 12px; background: var(--ap-bg-2);
    padding: 18px 20px 16px; transition: border-color 0.2s;
  }
  .card::before {
    content: ""; position: absolute; inset: -1px -1px auto; height: 3px; border-radius: 12px 12px 0 0; background: var(--m);
  }
  .card:hover { border-color: color-mix(in oklab, var(--m) 55%, transparent); }
  .card h3 { margin: 14px 0 6px; font: 700 1.6rem/1.05 var(--ap-font-display); letter-spacing: -0.03em; }
  .card h3 a { color: var(--ap-fg); text-decoration: none; }
  .card h3 a:hover { color: var(--m); }
  .status { display: flex; align-items: center; gap: 8px; margin: 0; font: 11px/1.6 var(--ap-font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ap-fg-3); }
  .line { margin: 12px 0 0; font-size: 16px; line-height: 1.5; color: var(--ap-fg-2); }
  .serves { display: grid; gap: 2px; margin: 14px 0 0; }
  .serves span { font: 9.5px/1.6 var(--ap-font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ap-fg-3); }
  .serves a { font: 500 15px/1.35 var(--ap-font-display); color: var(--accent-text); text-decoration: none; }
  .serves a::after { content: "\a0→"; color: var(--m); }
  .serves a:hover { color: var(--ap-fg); }
  .links { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 16px 0 0; padding-top: 12px; border-top: 1px solid var(--ap-line-soft); }
  .links a { font: 11px/1.6 var(--ap-font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ap-fg-3); text-decoration-color: var(--ap-line); }
  .links a:hover { color: var(--m); text-decoration-color: currentColor; }
  .links a::after { content: " ↗"; }
  .links a.go { color: var(--ap-accent); }
  .links a.go::after { content: " →"; }

  /* Its place in the loop: a stop per place, its own lit. */
  .track { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), 1fr); position: relative; }
  .track::before { content: ""; position: absolute; left: 4px; right: calc(100% / var(--n) - 4px); top: 4px; height: 1px; background: var(--ap-line); }
  .track.all::before { background: var(--m); }
  .track li {
    position: relative; padding-top: 16px; font: 9.5px/1.4 var(--ap-font-mono); letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ap-fg-3); opacity: 0.6;
  }
  .track li::before {
    content: ""; position: absolute; left: 0; top: 0; width: 9px; height: 9px; border-radius: 50%;
    background: var(--ap-bg-2); box-shadow: inset 0 0 0 1px var(--ap-line);
  }
  .track li.on { color: var(--ap-fg); opacity: 1; }
  .track li.on::before { background: var(--m); box-shadow: 0 0 0 4px color-mix(in oklab, var(--m) 22%, transparent); }
  /* A card too narrow for every stop's name keeps every stop and names its
     own place only. */
  .tools .card { container-type: inline-size; }
  @container (max-width: 15rem) {
    .track li:not(.on) { color: transparent; }
    .track li.on { white-space: nowrap; }
  }

  .umbrella { display: grid; gap: 18px 48px; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); align-items: start; padding: 24px 28px 20px; margin-bottom: 16px; }
  .umbrella { border-color: color-mix(in oklab, var(--m) 45%, transparent); background: linear-gradient(135deg, color-mix(in oklab, var(--ap-accent) 7%, transparent), transparent 55%), var(--ap-bg-2); }
  .umbrella .place { margin: 0; font: 11px/1.6 var(--ap-font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ap-accent); }
  .umbrella h3 { font-size: clamp(2.2rem, 4vw, 3rem); margin-top: 10px; color: var(--ap-fg); }
  .umbrella .line { font: 500 1.2rem/1.4 var(--ap-font-display); letter-spacing: -0.01em; color: var(--ap-fg); margin-top: 18px; }
  .umbrella .what { padding-top: 6px; }
  @media (max-width: 48rem) { .umbrella { grid-template-columns: 1fr; padding: 20px; } }

  /* No narrower than 13rem, and never more than --cols across. */
  .tools {
    list-style: none; margin: 0; padding: 0; display: grid; gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(max(13rem, (100% - (var(--cols) - 1) * 16px) / var(--cols)), 1fr));
  }
  /* The links sit at the foot of each card, whatever its line's length. */
  .tools .card { display: flex; flex-direction: column; }
  .tools .links { margin-top: auto; }
  .tools .card > :nth-last-child(2) { margin-bottom: 16px; }

  /* Alone, and joined: the two sections of the words, side by side. */
  .joined { margin-top: 64px; display: grid; gap: 24px 64px; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); border-top: 1px solid var(--ap-line-soft); padding-top: 8px; }
  .col :global(h2) { margin: 32px 0 14px; }
  .col :global(p) { margin: 0 0 14px; }
  .col :global(ul) { list-style: none; margin: 0; padding: 0; }
  .col :global(li) { padding: 12px 0; border-bottom: 1px solid var(--ap-line-soft); line-height: 1.55; }
  .col :global(li:first-child) { padding-top: 0; }
  .col :global(.named) { font: 700 1.05rem/1 var(--ap-font-display); letter-spacing: -0.02em; color: var(--ap-fg); white-space: nowrap; }
  .col :global(.named)::before {
    content: ""; display: inline-block; width: 8px; height: 8px; margin-right: 8px; border-radius: 50%; background: var(--m);
    vertical-align: 0.1em;
  }

  @media (prefers-reduced-motion: reduce) { .card { transition: none; } }
</style>
